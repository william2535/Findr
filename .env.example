# FINDR complete source export — no secret values.
# Ordinary local web development requires no application API key.
# Copy to .env.local only if you actually need optional overrides.
# Never commit real .env files or signing credentials.

# Optional separate Cloudflare deployment: supply in your shell/CI secret store.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional Android build SDK root; see android/build-apk.py and GITHUB-SETUP.md.
# FINDR_ANDROID_SDK=

# Optional tooling paths; defaults normally suffice.
# SITES_RUNTIME_ROOT=
# SITES_PNPM_SHARED_STORE=
# WRANGLER_LOG_PATH=
# WRANGLER_REGISTRY_PATH=
# MINIFLARE_REGISTRY_PATH=

# No OpenAI/cloud-LLM API key: inference runs locally using the downloaded model.
# Model URLs, pinned hashes and limits are in public/app/local-language-resources.mjs.
# Manual relay URL allowlist is lib/download-map.json; no publisher credential is included.
