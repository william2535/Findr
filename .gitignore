# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Android generated outputs (preview signing identity intentionally retained)
/android/build/
/android/assets/
/artifacts/

# Local Python fixture-generation bytecode.
__pycache__/
*.pyc

# Current APK is published on GitHub; too large for the Sites source host.
# Keep the local artifact and checksum; GitHub backup retains an explicit copy.
/public/releases/FINDR-0.37.0.apk

