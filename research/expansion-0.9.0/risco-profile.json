  "controls": [
    {
      "label": "↑ / ↓",
      "description": "Browse the displayed menu or detector list. UK user menus use scrolling, not invented shortcut numbers."
    },
    {
      "label": "OK / Menu",
      "description": "Green OK accepts a selection; Menu/Back returns or discards unconfirmed data."
    },
    {
      "label": "Full / Part Set",
      "description": "Changes programming choices. The HOUSE / Part Set key selects a zone for omission, then OK confirms."
    },
    {
      "label": "0–9",
      "description": "Installer quick keys select consecutive local options. Preserve two-digit values such as 01; the keypad does not treat a whole path as one field."
    },
    {
      "label": "0 then OK",
      "description": "Exit and save at the installer main menu."
    }
  ],
  "omissionInfo": {
    "label": "What “disable” means here",
    "meaning": "Omit excludes an eligible ordinary intrusion zone; it does not disconnect or power off the device.",
    "duration": "One Time Only is reinstated after the next set-and-unset cycle. Permanent Omit remains until changed; it has a separate screen in free mode.",
    "restore": "Return to Activities → Omit → Zones → One Time Only, find the zone, change it with Part Set and confirm with OK."
  },
