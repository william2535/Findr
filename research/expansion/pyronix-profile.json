  "limitations": [
    "Guided exercises contain selected branches; the free-use emulator provides the broader documented menu tree.",
    "This baseline is Enforcer V11, not a claim about EURO, Enforcer V10 or later V12 firmware.",
    "Wireless learning, real communications, battery loads and physical sounder behaviour are not simulated.",
    "Some printed value ranges/codes conflict or are incomplete; those fields are marked in Sources & accuracy.",
    "Predictive text and real keypad multi-tap timing are not reproduced.",
    "No matching physical keypad has been used to verify timing or screen-by-screen firmware fidelity."
  ],
  "omissionInfo": {
    "label": "Pyronix omission context",
    "meaning": "Master Manager OMIT INPUTS is the documented Day Alarm-only route. Ordinary omittable input bypass during setting is a separate workflow and is not substituted here.",
    "duration": "The guide says this manager omission lasts until the system has been armed and disarmed.",
    "restore": "Automatic reinstatement follows the documented arm/disarm cycle. Repeated-choice display details require matching keypad verification."
  },
